{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gym-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    // Used to decide which day a set belongs to on the dashboard and in "today" answers.
    "TIMEZONE": "Europe/London"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gym-tracker",
      "database_id": "0c8a6971-8721-44b6-9160-f75488020587",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (set with `npx wrangler secret put <NAME>`, never commit them):
  //   API_TOKEN           - Bearer token the Siri Shortcuts send
  //   DASHBOARD_PASSWORD  - password for the web dashboard
}
