{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gym-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "vars": {
    // Used to decide which day a set belongs to on the dashboard and in "today" answers.
    "TIMEZONE": "Europe/London",
    // Weekly cardio goal on the dashboard checklist.
    "CARDIO_WEEKLY_MINUTES": "90",
    // Daily steps goal line on the dashboard's steps chart.
    "STEPS_DAILY_GOAL": "8000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gym-tracker",
      "database_id": "0c8a6971-8721-44b6-9160-f75488020587",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (set as GitHub secrets or with `npx wrangler secret put <NAME>`, never commit them):
  //   DASHBOARD_PASSWORD - the sign-in password
  //   STEPS_TOKEN        - token the nightly steps automation sends (optional)
}
